{
  "name": "solidify-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Solidify API: accounts, progress sync, classes, shared scene links, feedback and the Gemini tutor",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
